msgid "DeepSeek …"
msgstr "DeepSeek …"

msgid "DeepSeek API"
msgstr "DeepSeek API"

msgid "Balance: —"
msgstr "余额：—"

msgid "Today (estimated): —"
msgstr "今日估算：—"

msgid "Topped up: — · Granted: —"
msgstr "充值余额：— · 赠金：—"

msgid "Updated: —"
msgstr "更新时间：—"

msgid "Refresh now"
msgstr "立即刷新"

